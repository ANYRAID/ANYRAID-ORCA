            <description>
                <p>See the release page for detailed changelog.</p>
            </description>
        </release>
        <release version="2.3.2" date="2025-03-23">
            <url type="details">https://github.com/ANYRAID/ANYRAID-ORCA/releases</url>
            <description>
                <p>See the release page for detailed changelog.</p>
            </description>
        </release>
    </releases>
</component>
